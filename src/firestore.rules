rules_version = '2';
service cloud.firestore {
    // Helper functions for auth & RBAC
    function isAuthenticated() {
        return request.auth != null;
    }

    function isTenantUser(tenantId) {
        return isAuthenticated() && request.auth.token.tenantId == tenantId;
    }

    function hasRole(role) {
        return isAuthenticated() && request.auth.token.role == role;
    }

    // Rules for the Enterprise Risk Register collection
    match /risks/{riskId} {
        allow read: if isTenantUser(resource.data.tenantId);
        allow create, update: if isTenantUser(request.resource.data.tenantId)
                              && (hasRole('Admin') || hasRole('Analyst'));
        allow delete: if isTenantUser(resource.data.tenantId)
                      && hasRole('Admin');
    }
}